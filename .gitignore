# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Env / secrets
.env
.env.*
!.env.example

# Doc Pool source PDFs (copyrighted arXiv papers, fetched locally per README)
data/doc_pool/*.pdf

# Embedding DB / FAISS indexes (rebuildable, per-teammate versioned)
# index*/ covers index/ (기본) and index_<embedding-name>/ (3.1절 임베딩 후보 비교용) 둘 다
scripts/*/pdf/v*/index*/
scripts/*/pdf/v*/*.faiss
scripts/*/pdf/v*/*.pkl
# 그래프 통합 실행용 공유 색인 (src/graph.py, config.DOC_POOL_INDEX_DIR)
data/doc_pool_index/

# Test results / generated reports & charts — 팀원과 공유하려고 추적함(gitignore 아님)
eval/results/

# Final assembled report (report agent output)
output/

# OS / editor
.DS_Store
.vscode/
.idea/
