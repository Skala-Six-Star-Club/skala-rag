# --- Generation LLM (OpenAI, 6.2절) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# --- Judge LLM (Ollama 로컬, 6.3절) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_JUDGE_MODEL=qwen3:8b
# OpenAI 키가 없을 때 생성 LLM을 대신할 로컬 모델(선택, 비우면 폴백 없음)
OLLAMA_GENERATION_MODEL=

# --- Embedding (로컬, 6.1절; 2026-09-22 비교실험으로 Qwen3-Embedding-0.6B 채택) ---
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# auto(기본): cuda -> mps(Apple Silicon) -> cpu 순으로 자동 선택. 강제하려면 cpu / cuda / cuda:0 / mps
EMBEDDING_DEVICE=auto
# 비우면 CUDA 64, MPS/CPU 32
EMBEDDING_BATCH_SIZE=
# CUDA에서만 fp16 로드(1). MPS/CPU는 값과 무관하게 fp32
EMBEDDING_FP16=1

# --- Web search (Tavily, 4장 공통 도구) ---
TAVILY_API_KEY=tvly-...

# --- Retrieval (7.2~7.4) ---
# Query Rewriting 기본 off(3차 비교실험 결과). 켜려면 1
QUERY_REWRITING=0

# --- Paths ---
DOC_POOL_DIR=./data/doc_pool
# 공유 색인 루트. 실제 색인은 <루트>/<임베딩 이름>/ 아래에 생겨 임베딩 교체 시 섞이지 않음
DOC_POOL_INDEX_DIR=./data/doc_pool_index
GOLDEN_DATASET_PATH=./eval/golden/golden_dataset.json
TARGET_EVIDENCE_COUNT=5
GROUNDING_MIN_SIMILARITY=0.35
# 보고서 본문 인용 표기: numeric(REFERENCE 번호, 기본) / none(표기 제거) / raw([근거#N] 유지)
REPORT_CITATION_STYLE=numeric
# 관점별 평가 절의 칸당 주장 수 상한(보고서 10장 상한용, 0이면 제한 없음)
REPORT_MAX_CLAIMS_PER_CELL=5

# --- LangSmith Tracing (동적 처리 확인용 트레이스) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=skala-agent-orchestrator

# --- Orchestrator-Workers ---
# llm: 생성 LLM이 칸별 초점을 고르고 계획 검증이 대칭, 커버리지, 상한을 보정 / rule: 칸마다 기본 초점 하나
PLANNER_MODE=llm
MAX_SUBTASKS=16
WORKER_MAX_RETRIES=1
MAX_QUALITY_REPLANS=1
MAX_QUALITY_REWRITES=1
MAX_STEPS=80
RECURSION_LIMIT=100

# --- 관측성, 재개 ---
DECISION_LOG_DIR=./output/logs
# sqlite / memory / none
CHECKPOINTER=sqlite
CHECKPOINT_DB_PATH=./output/checkpoints.sqlite

# --- 품질 평가(quality_eval) ---
QUALITY_MIN_SOURCES=2
QUALITY_MAX_RATIO=2.0
QUALITY_MIN_GROUNDED_RATIO=0.8
QUALITY_USE_LLM_JUDGE=1
