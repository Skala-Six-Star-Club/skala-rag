# --- Generation LLM (OpenAI, 6.2절) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# --- Judge LLM (Ollama 로컬, 6.3절) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_JUDGE_MODEL=qwen3:8b
# OpenAI 키가 없을 때 생성 LLM을 대신할 로컬 모델(선택, 비우면 폴백 없음)
OLLAMA_GENERATION_MODEL=

# --- Embedding (bge-m3, 로컬, 6.1절) ---
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# auto(기본): CUDA 가용 시 cuda, 아니면 cpu. 강제하려면 cpu / cuda / cuda:0
EMBEDDING_DEVICE=auto
# GPU 기본 64, CPU 기본 32
EMBEDDING_BATCH_SIZE=64
# CUDA에서 fp16 로드(1) / fp32(0)
EMBEDDING_FP16=1

# --- Web search (Tavily, 4장 공통 도구) ---
TAVILY_API_KEY=tvly-...

# --- Paths ---
DOC_POOL_DIR=./data/doc_pool
GOLDEN_DATASET_PATH=./eval/golden/golden_dataset.json

LANGSMITH_API_KEY=lsv2_...