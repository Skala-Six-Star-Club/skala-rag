# --- Generation LLM (OpenAI, 6.2절) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# --- Judge LLM (Ollama 로컬, 6.3절) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_JUDGE_MODEL=qwen3:8b

# --- Embedding (bge-m3, 로컬, 6.1절) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# --- Web search (Tavily, 4장 공통 도구) ---
TAVILY_API_KEY=tvly-...

# --- Paths ---
DOC_POOL_DIR=./data/doc_pool
DOC_POOL_INDEX_DIR=./data/doc_pool_index
GOLDEN_DATASET_PATH=./eval/golden/golden_dataset.json
TARGET_EVIDENCE_COUNT=5
GROUNDING_MIN_SIMILARITY=0.35
